# Convex deployment — created by `npx convex dev`, which writes the real values
# into .env.local. Copy this file to .env.local and paste your own values there.

# Public deployment URL the browser client connects to.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Written by the Convex CLI. Identifies the dev deployment it pushes to.
CONVEX_DEPLOYMENT=dev:your-deployment-name
